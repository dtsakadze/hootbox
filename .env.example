# Postgres connection string. Prefer 127.0.0.1 over "localhost" locally: on some
# systems localhost resolution makes new connections stall intermittently.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hootbox

# Only needed to run the test suite (database name must contain "test"; it gets wiped).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/hootbox_test

# Public URL of your Hootbox instance (used for links in the widget snippet & webhooks).
# Optional — falls back to the request origin.
# APP_URL=https://feedback.example.com

# Set to "false" when connecting through a transaction-mode pooler (PgBouncer, Supabase, Neon, Hyperdrive)
# DATABASE_PREPARE=false

# Max connections per server instance (use 1–3 on serverless platforms)
# DATABASE_POOL_MAX=10

# Rate limiting uses the X-Forwarded-For client IP. Set to "false" if Hootbox is
# exposed directly to the internet without a reverse proxy.
# TRUST_PROXY=true

# Webhooks to private/internal addresses are blocked by default.
# ALLOW_PRIVATE_WEBHOOKS=false
