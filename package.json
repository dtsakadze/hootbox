{
	"name": "hootbox",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check",
		"format": "biome check --write",
		"generate-routes": "tsr generate",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node scripts/migrate.mjs",
		"db:seed": "tsx scripts/seed.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-start": "1.168.60",
		"drizzle-orm": "^0.45.3",
		"lucide-react": "^1.52.0",
		"nitro": "3.0.260610-beta",
		"postgres": "^3.4.9",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^18.0.5",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"version": "0.1.0",
	"description": "Friendly, self-hostable feedback collection: widget, public board, roadmap and inbox.",
	"license": "MIT",
	"engines": {
		"node": ">=20.19"
	},
	"packageManager": "pnpm@12.3.4"
}
